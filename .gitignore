# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Data, runs and large artifacts (never commit datasets or images).
# Anchored with a leading "/" so they only match at the repo root (not src/talosaur/data/).
/data/
/datasets/
/runs/
/outputs/
/multirun/
/exports/
/checkpoints/
/logs/
*.pt
*.pth
*.onnx
*.ncnn.param
*.ncnn.bin
*.tar
*.zip
*.mp4
*.mov
*.h264
/wandb/

# Reports are committed, but not their large binary attachments
reports/**/*.png
reports/**/*.jpg
!reports/**/figures/*.png

# OS / editors
.DS_Store
.idea/
.vscode/
